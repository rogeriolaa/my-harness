# Copy to .env and edit. Everything here is optional — with no config at all
# the harness runs the built-in mock provider so you can see the loop immediately.

# Which adapter to use: openai | anthropic | mock
HARNESS_PROVIDER=openai

# Model name (depends on the provider you point at)
HARNESS_MODEL=gpt-4o-mini

# Base URL. ANY OpenAI-compatible server works:
#   OpenAI     -> https://api.openai.com/v1
#   Ollama     -> http://localhost:11434/v1
#   LM Studio  -> http://localhost:1234/v1
#   vLLM       -> http://localhost:8000/v1
#   OpenRouter -> https://openrouter.ai/api/v1
#   Groq       -> https://api.groq.com/openai/v1
HARNESS_BASE_URL=https://api.openai.com/v1

# API key (usually not needed for local servers)
HARNESS_API_KEY=

# Extra request headers as JSON, e.g. {"HTTP-Referer":"https://example.com"}
# HARNESS_HEADERS={}

# Generation knobs
# HARNESS_MAX_TOKENS=4096
# HARNESS_TEMPERATURE=0

# Context window used for the usage display. Leave unset to auto-detect from
# the provider's /models metadata, then a known-model table, then the provider
# default. Set it to override detection.
# HARNESS_CONTEXT_WINDOW=128000

# How many model<->tool round trips before giving up
# HARNESS_MAX_STEPS=25

# Ask before running tools: none | bash | all
#   none  run everything (default)
#   bash  ask before running shell commands
#   all   ask before running any tool
# HARNESS_APPROVE=none

# Root directory the tools are allowed to touch (defaults to the cwd)
# HARNESS_WORKSPACE=.

# Override the built-in system prompt entirely
# HARNESS_SYSTEM_PROMPT=
